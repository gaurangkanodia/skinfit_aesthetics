{
  "name": "skinfit-chatbot-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "ingest": "tsx src/ingest.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.2.18",
    "@langchain/google": "^0.2.11",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/pinecone": "^1.0.3",
    "@langchain/textsplitters": "^1.0.2",
    "@pinecone-database/pinecone": "^5.1.2",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.3.0",
    "langsmith": "^0.11.0",
    "nodemailer": "^10.1.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
